wire [7:0]q;

register abc( .clk(clk), .reset(reset), .enable(enable), 
.direction(direction), .serial_in(serial_in), .q(q));

always 
#5 clk = ~ clk;

initial begin

clk = 0;
reset = 0;
enable = 0;
direction = 0;
serial_in = 0;

#10;
reset = 1;enable = 1; direction = 1;
